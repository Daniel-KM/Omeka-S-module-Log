<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Log\Api\Representation\LogRepresentation[] $logs
 * @var \Log\Api\Representation\LogRepresentation[] $resources
 * @var \Log\Form\QuickSearchForm $formSearch
 * @var \Omeka\Form\ConfirmForm $formDeleteSelected
 * @var \Omeka\Form\ConfirmForm $formDeleteAll
 */

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$i18n = $plugins->get('i18n');
$escape = $plugins->get('escapeHtml');
$sortLink = $plugins->get('sortLink');
$assetUrl = $plugins->get('assetUrl');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$strLength = 240;

$this->htmlElement('body')->appendAttribute('class', 'logs browse');

$this->headLink()
    ->appendStylesheet($assetUrl('css/common-quick-search.css', 'Common'))
    ->appendStylesheet($assetUrl('css/job.css', 'Log'))
    ->appendStylesheet($assetUrl('css/log.css', 'Log'));
$this->headScript()
    ->appendFile($assetUrl('js/common-quick-search.js', 'Common'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/job.js', 'Log'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/log.js', 'Log'), 'text/javascript', ['defer' => 'defer']);

$userIsAllowedBatchDelete = $this->userIsAllowed(\Log\Api\Adapter\LogAdapter::class, 'batch_delete');
?>

<?= $this->pageTitle($translate('Logs')) ?>

<?= $this->logSearchFilters() ?>

<div class="browse-controls">
    <?= $this->pagination() ?>
    <button type="button" class="button search quick-search"><?= $escape($translate('Quick filter')) ?></button>
    <?= $this->browse()->renderSortSelector('logs') ?>
    <?php if ((int) $this->params()->fromQuery('page', 1) <= 1): ?>
    <button type="button" id="log-auto-refresh" class="button" aria-pressed="false" data-label-on="<?= $escapeAttr($translate('Auto refresh: on')) ?>" data-label-off="<?= $escapeAttr($translate('Auto refresh: off')) ?>" title="<?= $escapeAttr($translate('Automatically refresh the list, useful while a job is running (first page only).')) ?>"><?= $escape($translate('Auto refresh: off')) ?></button>
    <?php endif; ?>
</div>

<div id="page-actions">
</div>

<?php $this->trigger('view.browse.before'); ?>
<?php if (count($logs)): ?>
<form method='post' id="batch-form" class="disable-unsaved-warning">
    <div class="batch-inputs">
        <select class="batch-actions-select" name="batch_action" aria-label="<?= $escapeAttr($translate('Batch actions')) ?>">
            <option value="default"><?= $escape($translate('Batch actions')) ?></option>
            <?php if ($userIsAllowedBatchDelete): ?>
            <option value="delete-selected" class="batch-selected" disabled="disabled"><?= $escape($translate('Delete selected')) ?></option>
            <option value="delete-all"><?= $escape($translate('Delete all')) ?></option>
            <?php endif; ?>
        </select>
        <div class="batch-actions">
            <button type="button" class="button default active" disabled="disabled"><?= $escape($translate('Go')) ?></button>
            <input type="hidden" name="query" class="batch-query" value="<?= $escapeAttr(json_encode($this->params()->fromQuery())) ?>">
            <?php if ($userIsAllowedBatchDelete): ?>
            <button type="button" class="delete button sidebar-content delete-selected" data-sidebar-selector="#sidebar-delete-selected"><?= $escape($translate('Go')) ?></button>
            <button type="button" class="delete button sidebar-content delete-all" data-sidebar-selector="#sidebar-delete-all"><?= $escape($translate('Go')) ?></button>
            <?php endif; ?>
        </div>
    </div>

    <table class="tablesaw batch-edit" data-tablesaw-mode="stack">
        <thead>
            <tr>
                <th>
                    <?php if ($userIsAllowedBatchDelete): ?>
                    <input type="checkbox" class="select-all" aria-label="<?= $translate('Select all') ?>">
                    <?php endif; ?>
                    <?= $escape($translate('Message')) ?>
                </th>
                <?= $this->browse()->renderHeaderRow('logs') ?>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($logs as $log):
            $userIsAllowedDelete = $log->userIsAllowed('delete');
            ?>
        <tr>
            <td class="log-popover-parent">
                <?php if ($userIsAllowedBatchDelete): ?>
                <input type="checkbox" name="resource_ids[]" value="<?= $log->id() ?>"<?php if (!$userIsAllowedDelete): ?> disabled="disabled"<?php endif; ?>>
                <?php endif; ?>
                <span class="log-message">
                    <?php
                    $text = $log->text();
                    $shouldEscape = $text->getEscapeHtml();
                    $text = $text->translate();
                    $isLong = mb_strlen($shouldEscape ? $text : strip_tags($text)) > $strLength;
                    ?>
                    <?php if ($isLong): ?>
                    <span class="log-message-truncated truncate"><?= nl2br($escape(mb_substr(strip_tags($text), 0, $strLength))) . '…' ?></span>
                    <?php else: ?>
                    <?= $shouldEscape ? $escape($text) : $text ?>
                    <?php endif; ?>
                </span>
                <ul class="actions">
                    <?php if ($isLong): ?>
                    <li><button type="button" class="o-icon- fa fa-expand popover" title="<?= $escapeAttr($translate('Full log')) ?>" aria-label="<?= $escapeAttr($translate('Full log')) ?>"></button>
                        <div class="log-message-full log-popover-content log-popover-current"><?= $shouldEscape ? $escape($text) : $text ?></div>
                    </li>
                    <?php endif; ?>
                    <li><button type="button" class="o-icon- far fa-copy log-copy" title="<?= $escapeAttr($translate('Copy')) ?>" aria-label="<?= $escapeAttr($translate('Copy')) ?>"></button></li>
                    <?php if ($userIsAllowedDelete): ?>
                    <li><?= $hyperlink('', '#', [
                        'data-sidebar-selector' => '#sidebar',
                        'data-sidebar-content-url' => $log->url('delete-confirm'),
                        'class' => 'o-icon-delete sidebar-content',
                        'title' => $translate('Delete'),
                        'aria-label' => $translate('Delete'),
                    ]) ?></li>
                    <?php endif; ?>
                    <li><?= $hyperlink('', '#', [
                        'data-sidebar-selector' => '#sidebar',
                        'data-sidebar-content-url' => $log->url('show-details'),
                        'class' => 'o-icon-more sidebar-content',
                        'title' => $translate('Details'),
                        'aria-label' => $translate('Details'),
                    ]) ?></li>
                </ul>
            </td>
            <?= $this->browse()->renderContentRow('logs', $log) ?>
        </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</form>

<?php $this->trigger('view.browse.after'); ?>
<div class="browse-controls">
    <?= $this->pagination() ?>
</div>

<div id="sidebar" class="sidebar">
    <?= $hyperlink('', '#', [
        'class' => 'sidebar-close o-icon-close',
        'title' => $translate('Close'),
        'aria-label' => $translate('Close'),
    ]) ?>
    <div class="sidebar-content"></div>
</div>

<?php if ($userIsAllowedBatchDelete): ?>

<div id="sidebar-delete-selected" class="sidebar">
    <?= $hyperlink('', '#', [
        'class' => 'sidebar-close o-icon-close',
        'title' => $translate('Close'),
        'aria-label' => $translate('Close'),
    ]) ?>
    <div class="sidebar-content">
        <div id="sidebar-confirm">
            <h3><?= $escape($translate('Delete logs')) ?></h3>
            <p><?= $escape($translate('Are you sure you would like to delete the selected logs?')) ?></p>
            <p class="error"><?= sprintf(
                $escape($translate('%s: this action will permanently delete %s logs and cannot be undone.')),
                sprintf('<strong>%s</strong>', $escape($translate('Warning'))),
                '<strong><span id="delete-selected-count"></span></strong>'
            ) ?></p>
            <?= $this->form($this->formDeleteSelected) ?>
        </div>
    </div>
</div>
<div id="sidebar-delete-all" class="sidebar">
    <?= $hyperlink('', '#', [
        'class' => 'sidebar-close o-icon-close',
        'title' => $translate('Close'),
        'aria-label' => $translate('Close'),
    ]) ?>
    <div class="sidebar-content">
        <div id="sidebar-confirm">
            <h3><?= $escape($translate('Delete logs')) ?></h3>
            <p><?= $escape($translate('Are you sure you would like to delete all logs of this result?')) ?></p>
            <p class="error"><?= sprintf(
                $escape($translate('%s: this action will permanently delete %s logs and cannot be undone.')),
                sprintf('<strong>%s</strong>', $escape($translate('Warning'))),
                sprintf('<strong>%s</strong>', number_format($this->pagination()->getPaginator()->getTotalCount()))
            ) ?></p>
            <label><input type="checkbox" name="confirm-delete-all-check"> <?= $escape($translate('Are you sure?')) ?></label>
            <?= $this->form($this->formDeleteAll) ?>
        </div>
    </div>
</div>

<?php endif; ?>

<?php else: ?>

<div class="no-resources">
    <p><?= $escape($translate('Omeka could not find any logs, or they are saved in another place.')) ?></p>
</div>

<?php endif; ?>

<?= $this->partial('common/quick-search-sidebar', [
    'formSearch' => $formSearch,
    'title' => $translate('Filter logs'),
]) ?>


<?php //= $this->partial('common/dialog/log') ?>
