<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\JobRepresentation[] $jobs
 */

// Copy of Omeka application/view/omeka/admin/job/browse.phtml, with added links.

use Log\Stdlib\JobLogCounter;
use Log\Stdlib\JobState;

$plugins = $this->getHelperPluginManager();
$url = $this->plugin('url');
$i18n = $this->plugin('i18n');
$escape = $plugins->get('escapeHtml');
$assetUrl = $plugins->get('assetUrl');
$jobState = $plugins->get('jobState');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$this->htmlElement('body')->appendAttribute('class', 'jobs browse');

$this->headLink()
    ->appendStylesheet($assetUrl('css/job.css', 'Log'));
$this->headScript()
    ->appendFile($assetUrl('js/job.js', 'Log'), 'text/javascript', ['defer' => 'defer']);

$stateLabels = array_map($translate, array_column(JobState::STATES, 'label', 's'));

$stateWarning = $escapeAttr($translate('Warning: The system state may not be reliable on some servers.'));
$stateWarning = sprintf(' title="%1$s" aria-label="%1$s"', $stateWarning);

$jobStateUrlBase = strtr($url('admin/job-state', ['id' => '0000']), ['0000' => '{id}']);

/** @var \Log\Stdlib\JobLogCounter $jobLogCounter */
$jobLogCounter = $plugins->get('api')->read('vocabularies', 1)->getContent()->getServiceLocator()->get('Log\JobLogCounter');
$logCountsByJob = $jobLogCounter->count(array_map(fn ($job) => $job->id(), $jobs));
$levelLabels = [
    JobLogCounter::ERRORS => $translate('Errors: %d'),
    JobLogCounter::WARNINGS => $translate('Warnings: %d'),
];
$levelQueries = [
    JobLogCounter::ERRORS => ['severity_min' => 3],
    JobLogCounter::WARNINGS => ['severity' => 4],
];

$filterQuery = $this->params()->fromQuery();
unset($filterQuery['page'], $filterQuery['status'], $filterQuery['log_level']);
$currentFilter = $this->params()->fromQuery('log_level') ?: ($this->params()->fromQuery('status') === 'error' ? 'failed' : 'all');
$filters = [
    'all' => [$translate('All'), $filterQuery],
    'failed' => [$translate('Failed'), ['status' => 'error'] + $filterQuery],
    JobLogCounter::ERRORS => [$translate('With errors'), ['log_level' => JobLogCounter::ERRORS] + $filterQuery],
    JobLogCounter::WARNINGS => [$translate('With warnings'), ['log_level' => JobLogCounter::WARNINGS] + $filterQuery],
];
$filterOptions = '';
foreach ($filters as $key => [$label, $query]) {
    $filterOptions .= sprintf(
        '<option value="%s"%s>%s</option>',
        $escapeAttr($url(null, [], ['query' => $query], true)),
        $key === $currentFilter ? ' selected="selected"' : '',
        $escape($label)
    );
}
$filterSelect = '<select class="job-filter" aria-label="' . $escapeAttr($translate('Filter jobs')) . '">' . $filterOptions . '</select>';
?>

<?php // Display the state below the status. ?>
<style>
    .system-state-header {
        float: right;
        font-weight: normal;
    }
    .flex-between .tablesaw-cell-content {
        flex-wrap: wrap;
        justify-content: space-between;
    }
    .flex-br {
        flex-basis: 100%;
        height: 0;
    }
</style>

<?= $this->pageTitle($translate('Jobs')) ?>

<div class="browse-controls">
    <?= $this->pagination() ?>
    <?= $this->browse()->renderSortSelector('jobs') ?>
</div>
<?php $this->trigger('view.browse.before'); ?>

<?php if (count($jobs)): ?>
<table class="tablesaw" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th>
                <span><?= $escape($translate('Id (Params)')) ?></span>
                <span class="system-state-header"<?= $stateWarning ?>><?= $escape($translate('System state')) ?></span>
            </th>
            <th><?= $escape($translate('Date')) ?></th>
            <th><?= $escape($translate('Class')) ?></th>
            <th>
                <span><?= $escape($translate('Status (Log)')) ?></span>
                <?= $filterSelect ?>
            </th>
            <th><?= $escape($translate('Owner')) ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($jobs as $job):
        $jobId = $job->id();
        if ($owner = $job->owner()) {
            $ownerText = $hyperlink($owner->email(), $url(
                'admin/id',
                ['controller' => 'user', 'action' => 'show', 'id' => $owner->id()]
            ));
        } else {
            $ownerText = $escape($translate('[No owner]'));
        }
        $logCounts = $logCountsByJob[$jobId] ?? [];
        $totalLogs = $logCounts['total'] ?? 0;
        $step = method_exists($job, 'step') ? $job->step() : null;
        $state = $jobState($job);
        ?>
        <tr>
            <td class="job-state flex-between" data-job-id="<?= $jobId ?>" data-job-state="<?= $state ?>"<?php if ($state && JobState::STATES[$state]['processing']): ?> data-job-state-url="<?= strtr($jobStateUrlBase, ['{id}' => $jobId]) ?>" <?php endif; ?>>
                <span><?= $job->link($jobId) ?></span>
                <?php if ($state): ?>
                <span class="system-state-icon <?= JobState::STATES[$state]['icon'] ?>" role="img" title="<?= $escapeAttr($stateLabels[$state]) ?>" aria-label="<?= $escapeAttr($stateLabels[$state]) ?>"></span>
                <?php endif; ?>
            </td>
            <td><?= $escape($i18n->dateFormat($job->started(), null, \Omeka\View\Helper\i18n::DATE_FORMAT_SHORT)) ?></td>
            <td><?= $escape($job->jobClass()) ?></td>
            <td class="job-status" data-job-id="<?= $job->id() ?>">
                <?php if ($totalLogs): ?>
                <?= $hyperlink($translate($job->statusLabel()), $url('admin/log/default', [], ['query' => ['job_id' => $jobId]]), ['class' => 'status-link log-link job-status-label']) ?>
                <?php else: ?>
                <span class="job-status-label" data-job-id="<?= $jobId ?>"><?= $escape($translate($job->statusLabel())) ?></span>
                <?php endif; ?>
                <?php if ($step): ?>
                <span> - </span>
                <span class="job-status-step"><?= $step; ?></span>
                <span> / </span>
                <span class="job-status-steps"><?= $job->totalSteps() ?></span>
                <?php endif; ?>
                <?php if (!empty($logCounts[JobLogCounter::ERRORS]) || !empty($logCounts[JobLogCounter::WARNINGS])): ?>
                <div class="job-log-counts">
                    <?php foreach ($levelLabels as $level => $levelLabel): if (empty($logCounts[$level])) continue; ?>
                    <?= $hyperlink(sprintf($levelLabel, $logCounts[$level]), $totalLogs
                        ? $url('admin/log/default', [], ['query' => ['job_id' => $jobId] + $levelQueries[$level]])
                        : $url('admin/id', ['controller' => 'job', 'action' => 'log', 'id' => $jobId]), ['class' => 'job-log-count job-log-' . $level]) ?>
                    <?php endforeach; ?>
                </div>
                <?php endif; ?>
            </td>
            <td><?= $ownerText ?></td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
<?php $this->trigger('view.browse.after'); ?>
<div class="browse-controls">
    <?= $this->pagination() ?>
</div>

<?php else: ?>

<div class="no-resources">
    <p><?= $escape($translate('Omeka could not find any jobs.')) ?></p>
    <?php if ($currentFilter !== 'all'): ?>
    <p><?= $filterSelect ?></p>
    <?php endif; ?>
</div>

<?php endif; ?>
